# =============================================================================
# Soccer Data Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Scorebat (ingestion) ---
SCOREBAT_TOKEN="your-scorebat-api-token-here"
SCOREBAT_BASE_URL="https://www.scorebat.com/v3/api"
SCOREBAT_FETCH_WINDOW_DAYS=14
API_RATE_LIMIT_RPS=0.16

# --- PostgreSQL (shared) ---
DATABASE_URL="postgresql+asyncpg://soccer_user:your_password@localhost:5432/soccerdb"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Redis (cache) ---
REDIS_URL="redis://localhost:6379/0"

# --- API Server ---
API_HOST="0.0.0.0"
API_PORT=8000
API_DEBUG=false
API_LOG_LEVEL="info"

# --- Cache TTLs (seconds) ---
CACHE_TTL_LIVE_S=30
CACHE_TTL_HISTORICAL_S=86400
CACHE_TTL_LEAGUES_S=3600
CACHE_TTL_FIXTURES_DATE_S=120

# --- Synchronisation intervals (seconds) ---
WEEKLY_FIXTURES_INTERVAL_S=43200
PRE_MATCH_LINEUPS_WINDOW_S=0
LIVE_ENGINE_POLL_S=30
