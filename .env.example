# =============================================================================
# Soccer Data Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# --- API-Football (ingestion) ---
API_FOOTBALL_KEY="your-api-key-here"
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_RATE_LIMIT_RPS=9.0

# --- PostgreSQL (shared) ---
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/soccerdb"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Redis (cache) ---
REDIS_URL="redis://localhost:6379/0"

# --- API Server ---
API_HOST="0.0.0.0"
API_PORT=8000
API_DEBUG=false
API_LOG_LEVEL="info"

# --- Cache TTLs (seconds) ---
CACHE_TTL_LIVE_S=30
CACHE_TTL_HISTORICAL_S=86400
CACHE_TTL_LEAGUES_S=3600
CACHE_TTL_FIXTURES_DATE_S=120

# --- Synchronisation intervals (seconds) ---
WEEKLY_FIXTURES_INTERVAL_S=86400
PRE_MATCH_LINEUPS_WINDOW_S=2700
LIVE_ENGINE_POLL_S=60
